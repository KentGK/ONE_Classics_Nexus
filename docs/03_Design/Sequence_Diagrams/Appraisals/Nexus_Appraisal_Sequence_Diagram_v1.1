    Aggregate -- "Return domain result / apply state" --> Service

    Service -- "Load / Persist" --> Repo
    Repo -- "SELECT / INSERT / UPDATE / DELETE" --> Db
    Db -- "Record(s)" --> Repo

    Service -- "Write audit event" --> Audit
    Service -- "Invalidate / Update cache" --> Cache
    Service -- "Request valuation / market data" --> Valuation
    Service -- "Send notifications (creation/update)" --> Notification

    Cache -- "Cached appraisal" --> Service
    Audit -- "Audit entries" --> Repo
