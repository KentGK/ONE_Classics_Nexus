    classDef infrastructure fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
    classDef database fill:#fce4ec,stroke:#ad1457,color:#880e4f

    class Client,AppraisalsController,CreateRequest api
    class CreateHandler,GetHandler,IAppraisalRepository,IVehicleRepository,DomainMappings,AppraisalDto application
    class Appraisal,AppraisalBehavior,Vehicle,Inspection,AppraisalRequest,Client,Appraiser,Reviewer domain
    class AppraisalRepository,VehicleRepository,MySqlFactory infrastructure
    class AppraisalsTable database